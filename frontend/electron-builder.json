{
  "productName": "Bus Driver Management",
  "appId": "com.busdriver.app",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "main.cjs",
    "package.json"
  ],
  "mac": {
    "target": "dmg",
    "icon": "assets/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icon.png"
  },
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Bus Driver Management"
  }
}
